+  return json.loads(buf.getvalue())
+ def test_explicit_source_maps_without_preparing(self):
+  result=self.invoke(self.args);self.assertEqual(result['selected_parts'],1);self.assertFalse(result['assets_prepared']);data=json.loads((self.root/'output/preparations.json').read_text());row=next(iter(data['selections'].values()));self.assertNotEqual(row['package'],'/never/used');self.assertEqual(row['part_id'],self.pid)
