+ if type(ctx)is not dict or set(ctx)!=keys:raise ValueError('context shape')
+ conn=sqlite3.connect(index.as_uri()+'?mode=ro&immutable=1',uri=True);rows=[];verified={}
+ try:
+  for part in a.part:
+   matches=conn.execute('SELECT row_json FROM parts WHERE part_id=? LIMIT 2',(part,)).fetchall()
