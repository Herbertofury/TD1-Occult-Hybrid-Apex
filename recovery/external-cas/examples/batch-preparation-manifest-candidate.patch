+  name='p'+part[:14];out='v'+part[:14];token=hashlib.sha256(('preparation:'+part).encode()).hexdigest()[:32]
+  variant={k:ctx[k] for k in ('base_token','base','base_sha','manifest','manifest_sha','binary','binary_sha','helper','helper_sha','policy','pose_config','pose_config_sha')};variant.update(slot=slot,counterpart=ctx['hair_counterpart' if slot=='hair' else 'dress_counterpart'],output=out)
+  selections[token]={'catalog':str(index),'catalog_sha':a.catalog[1],'part_id':part,'package':str(path),'rig':ctx['rig'],'rig_sha':ctx['rig_sha'],'name':name,'variant':variant}
