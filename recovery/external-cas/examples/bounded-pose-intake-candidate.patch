+from cas_resource_catalog import Package,tgi
+from decode_clip import decode
+p=argparse.ArgumentParser();p.add_argument('package');p.add_argument('sha256');p.add_argument('output_name');a=p.parse_args();source=pathlib.Path(a.package);name=a.output_name
