+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Synthetic preflight tests; no native game or hostile input claim."""
+import contextlib,hashlib,io,json,pathlib,sqlite3,tempfile,unittest
+from unittest import mock
+import preflight_catalog_selection as p
+class Tests(unittest.TestCase):
+ def setUp(self):
+  self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup);self.root=pathlib.Path(self.tmp.name);self.pkg=self.root/'creator.package';self.pkg.write_bytes(b'example');self.hash=hashlib.sha256(b'example').hexdigest();self.id='a'*64;self.cat=self.root/'catalog.sqlite';db=sqlite3.connect(self.cat);db.execute('CREATE TABLE parts(part_id TEXT PRIMARY KEY,row_json TEXT NOT NULL)');self.row={'part_id':self.id,'body_type':2,'package_sha256':self.hash,'resource_sha256':'b'*64,'resource_tgi':'034AEECB:80000000:0123456789ABCDEF'};db.execute('INSERT INTO parts VALUES(?,?)',(self.id,json.dumps(self.row)));db.commit();db.close();self.sha=hashlib.sha256(self.cat.read_bytes()).hexdigest();self.argv=['test','--catalog',str(self.cat),self.sha,'--part-id',self.id,'--package',str(self.pkg),'--output','case']
+ def runner(self,args,**kwargs):
+  out=self.root/args[args.index('--output')+1];out.mkdir();(out/'resolution.json').write_text(json.dumps({'body_type':2,'references':[{'role':'lod-0','state':'source-present-not-rendered'},{'role':'texture','state':'source-present-not-rendered'}]}));return type('Run',(),{'stdout':b'', 'stderr':b'', 'returncode':0})()
+ def run_case(self,argv=None):
+  buf=io.StringIO()
+  with mock.patch.object(p,'PRIVATE',self.root),mock.patch.object(p.sys,'argv',argv or self.argv),mock.patch.object(p.subprocess,'run',side_effect=self.runner),contextlib.redirect_stdout(buf):p.main()
+  return json.loads(buf.getvalue())
+ def test_exact_identity_yields_bounded_preflight_only(self):
+  result=self.run_case();self.assertTrue(result['resources_present']);self.assertFalse(result['preview_prepared']);self.assertFalse(result['game_modified']);self.assertEqual(result['compatibility'],'unverified')
+ def test_wrong_package_and_unknown_part_refused_without_output(self):
+  self.pkg.write_bytes(b'different')
+  with self.assertRaises(ValueError):self.run_case()
+  self.assertFalse((self.root/'case-resolution').exists())
+  args=self.argv.copy();args[args.index('--part-id')+1]='c'*64
+  with self.assertRaises(ValueError):self.run_case(args)
+  self.assertFalse((self.root/'case-resolution').exists())
+ def test_existing_output_and_wrong_catalog_pin_refused(self):
+  (self.root/'case-resolution').mkdir()
+  with self.assertRaises(ValueError):self.run_case()
+  args=self.argv.copy();args[args.index('--catalog')+2]='d'*64
+  with self.assertRaises(ValueError):self.run_case(args)
+if __name__=='__main__':unittest.main(verbosity=2)
