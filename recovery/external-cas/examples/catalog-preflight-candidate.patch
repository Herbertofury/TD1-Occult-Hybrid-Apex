+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Inspect a selected, pinned catalog part against a caller-selected package.
+
+Diagnostic only. Does not equip, alter the game, create native saves, assert
+rig compatibility, or sandbox hostile packages. The parent must review and
+own the package and rig; a catalog path is never opened implicitly.
+"""
+import argparse,hashlib,json,pathlib,re,sqlite3,subprocess,sys,time
+from build_scene_bindings import pin,PRIVATE,D,N
+T=re.compile(r'034AEECB:[0-9A-F]{8}:[0-9A-F]{16}\Z')
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--catalog',nargs=2,required=True,metavar=('PATH','SHA256'));p.add_argument('--part-id',required=True);p.add_argument('--package',required=True);p.add_argument('--output',required=True);a=p.parse_args()
+ if not D.fullmatch(a.part_id) or not N.fullmatch(a.output):raise ValueError('opaque part ID and fresh output name required')
+ index=pathlib.Path(a.catalog[0]);pin(index,a.catalog[1],256*1024*1024)
+ if index.stat().st_nlink!=1 or any(pathlib.Path(str(index)+s).exists() or pathlib.Path(str(index)+s).is_symlink() for s in ('-wal','-shm','-journal')):raise ValueError('standalone catalog required')
+ conn=sqlite3.connect(index.as_uri()+'?mode=ro&immutable=1',uri=True);deadline=time.monotonic()+10;conn.set_progress_handler(lambda:int(time.monotonic()>deadline),10000)
+ try: rows=conn.execute('SELECT row_json FROM parts WHERE part_id=? LIMIT 2',(a.part_id,)).fetchall()
+ finally:conn.close()
+ if len(rows)!=1 or len(rows[0][0])>1024*1024:raise ValueError('part absent or ambiguous')
+ row=json.loads(rows[0][0]);package=pathlib.Path(a.package)
+ if row.get('part_id')!=a.part_id or row.get('body_type') not in (2,5) or not all(isinstance(row.get(k),str) and D.fullmatch(row[k]) for k in ('package_sha256','resource_sha256')) or not isinstance(row.get('resource_tgi'),str) or not T.fullmatch(row['resource_tgi']):raise ValueError('unsupported or invalid catalog identity')
+ pin(package,row['package_sha256'],64*1024*1024);pin(index,a.catalog[1],256*1024*1024)
+ out=PRIVATE/(a.output+'-resolution')
+ if out.exists() or out.is_symlink():raise ValueError('fresh output required')
+ script=pathlib.Path(__file__).resolve().parent/'resolve_pinned_casp.py';args=[sys.executable,str(script),'--package',str(package),'--package-sha',row['package_sha256'],'--casp',row['resource_tgi'],'--casp-sha',row['resource_sha256'],'--output',out.name]
+ run=subprocess.run(args,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=90,check=False)
+ if len(run.stdout)>65536 or len(run.stderr)>65536 or run.returncode:raise ValueError('source resolution failed; completed evidence retained')
+ resolution=json.loads((out/'resolution.json').read_bytes());expected=row['body_type']
+ if resolution.get('body_type')!=expected:raise ValueError('source slot differs from catalog')
+ refs=resolution.get('references',[]);meshes=[x for x in refs if x.get('role')=='lod-0'];textures=[x for x in refs if x.get('role')=='texture'];ready=1<=len(meshes)<=8 and len(textures)==1 and all(x.get('state')=='source-present-not-rendered' for x in meshes+textures)
+ print(json.dumps({'part_id':a.part_id,'slot':'hair' if expected==2 else 'dress','declared_lod0':len(meshes),'declared_textures':len(textures),'resources_present':ready,'preview_prepared':False,'game_modified':False,'compatibility':'unverified'}))
+if __name__=='__main__':main()
