+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Prepare one caller-selected pinned catalog part for a private diagnostic.
+
+The caller chooses the local package and independently pinned rig. This does
+not select paths from catalog metadata, open game files, equip, verify native
+compatibility, sandbox hostile inputs, or publish a scene. Failures retain
+completed stages; use a fresh name for each run.
+"""
+import argparse,json,pathlib,re,sqlite3,subprocess,sys
+from build_scene_bindings import pin,D
+N=re.compile(r'[a-z0-9][a-z0-9-]{0,15}\Z');HERE=pathlib.Path(__file__).resolve().parent
+def stage(script,args,timeout):
+ r=subprocess.run([sys.executable,str(HERE/script),*map(str,args)],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout,check=False)
+ if len(r.stdout)>65536 or len(r.stderr)>65536 or r.returncode:raise ValueError('preparation stage failed; completed evidence retained')
+ return json.loads(r.stdout)
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--catalog',nargs=2,required=True,metavar=('PATH','SHA256'));p.add_argument('--part-id',required=True);p.add_argument('--package',required=True);p.add_argument('--rig',nargs=2,required=True,metavar=('PATH','SHA256'));p.add_argument('--name',required=True);a=p.parse_args()
+ if not N.fullmatch(a.name) or not D.fullmatch(a.part_id):raise ValueError('invalid run name or selected part')
+ pin(pathlib.Path(a.rig[0]),a.rig[1],16*1024*1024)
+ result=stage('preflight_catalog_selection.py',['--catalog',*a.catalog,'--part-id',a.part_id,'--package',a.package,'--output',a.name+'-preflight'],120)
+ if result.get('part_id')!=a.part_id or result.get('resources_present') is not True or result.get('game_modified') is not False or result.get('slot') not in ('hair','dress'):raise ValueError('unsupported or incomplete source resources')
+ index=pathlib.Path(a.catalog[0]);pin(index,a.catalog[1],256*1024*1024);db=sqlite3.connect(index.as_uri()+'?mode=ro&immutable=1',uri=True)
+ try:rows=db.execute('SELECT row_json FROM parts WHERE part_id=? LIMIT 2',(a.part_id,)).fetchall()
+ finally:db.close()
+ if len(rows)!=1 or len(rows[0][0])>1024*1024:raise ValueError('catalog part no longer unique')
+ row=json.loads(rows[0][0]);pin(index,a.catalog[1],256*1024*1024)
+ if row.get('part_id')!=a.part_id or row.get('body_type')!=({'hair':2,'dress':5}[result['slot']]) or not all(isinstance(row.get(k),str) and D.fullmatch(row[k]) for k in ('package_sha256','resource_sha256')) or not re.fullmatch(r'034AEECB:[0-9A-F]{8}:[0-9A-F]{16}',row.get('resource_tgi','')):raise ValueError('catalog identity mismatch')
+ payload=stage('prepare_hair_pipeline.py' if result['slot']=='hair' else 'prepare_dress_pipeline.py',['--package',a.package,'--package-sha',row['package_sha256'],'--casp',row['resource_tgi'],'--casp-sha',row['resource_sha256'],'--rig',a.rig[0],'--rig-sha',a.rig[1],'--name',a.name],900)
+ if payload.get('game_modified') is not False or payload.get('native_fidelity')!='unverified':raise ValueError('invalid preparation result')
+ print(json.dumps({'part_id':a.part_id,'slot':result['slot'],'source_meshes':payload['source_meshes'],'prepared':True,'game_modified':False,'native_fidelity':'unverified','age_rig_compatibility':'unverified'}))
+if __name__=='__main__':main()
