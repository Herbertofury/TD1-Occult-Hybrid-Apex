+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Synthetic orchestration checks; actual files tested separately."""
+import contextlib,hashlib,io,json,pathlib,sqlite3,tempfile,unittest
+from unittest import mock
+import prepare_catalog_selection as p
+class Tests(unittest.TestCase):
+ def setUp(self):
+  self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup);root=pathlib.Path(self.tmp.name);self.rig=root/'rig';self.rig.write_bytes(b'rig');rh=hashlib.sha256(b'rig').hexdigest();self.db=root/'index.sqlite';c=sqlite3.connect(self.db);c.execute('CREATE TABLE parts(part_id TEXT PRIMARY KEY,row_json TEXT)');self.row={'part_id':'a'*64,'body_type':2,'package_sha256':'b'*64,'resource_sha256':'c'*64,'resource_tgi':'034AEECB:80000000:0123456789ABCDEF'};c.execute('INSERT INTO parts VALUES(?,?)',(self.row['part_id'],json.dumps(self.row)));c.commit();c.close();dh=hashlib.sha256(self.db.read_bytes()).hexdigest();self.args=['x','--catalog',str(self.db),dh,'--part-id',self.row['part_id'],'--package',str(root/'owned.package'),'--rig',str(self.rig),rh,'--name','test-run'];self.calls=[]
+ def stage(self,script,args,timeout):
+  self.calls.append((script,args));return {'part_id':'a'*64,'resources_present':True,'game_modified':False,'slot':'hair'} if script=='preflight_catalog_selection.py' else {'source_meshes':3,'game_modified':False,'native_fidelity':'unverified'}
+ def runit(self,stage=None):
+  o=io.StringIO()
+  with mock.patch.object(p.sys,'argv',self.args),mock.patch.object(p,'stage',side_effect=stage or self.stage),contextlib.redirect_stdout(o):p.main()
+  return json.loads(o.getvalue())
+ def test_selected_hair_passes_rig_and_hash_as_separate_flags(self):
+  result=self.runit();self.assertTrue(result['prepared']);self.assertEqual(self.calls[1][0],'prepare_hair_pipeline.py');args=self.calls[1][1];self.assertEqual(args[args.index('--rig')+1],str(self.rig));self.assertEqual(args[args.index('--rig-sha')+1],hashlib.sha256(b'rig').hexdigest());self.assertFalse(result['game_modified'])
+ def test_incomplete_preflight_does_not_prepare(self):
+  def bad(script,args,timeout):self.calls.append((script,args));return {'part_id':'a'*64,'resources_present':False,'game_modified':False,'slot':'hair'}
+  with self.assertRaises(ValueError):self.runit(bad)
+  self.assertEqual(len(self.calls),1)
+if __name__=='__main__':unittest.main(verbosity=2)
