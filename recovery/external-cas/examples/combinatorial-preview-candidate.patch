+  self.owner=FakeOwner();self.g=Gateway(self.owner,{'1'*32:'First','2'*32:'Second'});self.t=threading.Thread(target=self.g.serve_forever,daemon=True);self.t.start();self.host,self.port=self.g.server_address;self.origin=f'http://{self.host}:{self.port}'
