+//! Private offline posed scene diagnostic; no game or collection writes.
+pub mod cc_scene;
+use std::{fs,io::Write};use sha2::{Digest,Sha256};
+fn main()->Result<(),Box<dyn std::error::Error>>{
+ let a:Vec<_>=std::env::args().collect();if a.len()!=8{return Err("scene-dir head dress shoes hair pose-id output.ppm".into());}
+ let scene=cc_scene::CcScene::load(&a[1..6])?;let frame=scene.render_clip_swatch(cc_scene::swatch_catalog::DEFAULT_ID,&a[6],0,0,[0,0,0,16384])?;
+ let mut out=fs::OpenOptions::new().write(true).create_new(true).open(&a[7])?;out.write_all(b"P6\n512 512\n255\n")?;out.write_all(&frame.rgb)?;out.flush()?;
+ println!("{{\"rgb_sha256\":\"{:x}\",\"triangles\":{},\"covered_pixels\":{},\"game_applied\":false}}",Sha256::digest(&frame.rgb),frame.triangles,frame.covered_pixels);Ok(())
+}
