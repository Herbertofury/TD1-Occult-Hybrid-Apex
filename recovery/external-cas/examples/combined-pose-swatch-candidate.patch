+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Project a caller-supplied, hash-pinned rig into the sampler's bounded text format."""
+import argparse,hashlib,pathlib,sys
+root=pathlib.Path(__file__).resolve().parents[1];sys.path.insert(0,str(root/'rig-recovery'))
+from inspect_rig import inspect_rig
+p=argparse.ArgumentParser();p.add_argument('rig');p.add_argument('sha256');p.add_argument('output');a=p.parse_args();source=pathlib.Path(a.rig);assert source.is_file() and not source.is_symlink();raw=source.read_bytes();assert len(raw)<=4*1024*1024 and hashlib.sha256(raw).hexdigest()==a.sha256
+rig=inspect_rig(raw);bones=rig['bones'];assert len(bones)==165 and all(b['parent']<i for i,b in enumerate(bones)) and all(abs(v-1)<1e-6 for b in bones for v in b['scale'])
+text=str(len(bones))+'\n'+'\n'.join(' '.join(map(str,[b['hash'],b['parent'],*b['position'],*b['orientation'],*b['scale']])) for b in bones)+'\n'
+with pathlib.Path(a.output).open('x') as out:out.write(text)
+print('verified adult bones:',len(bones),'source sha256:',rig['sha256'])
