+# SPDX-License-Identifier: GPL-3.0-or-later
+import unittest
+from extend_variant_bindings import extend
+from scene_switch_supervisor import Refused
+class Tests(unittest.TestCase):
+ def setUp(self):
+  self.tokens={str(i)*32 for i in range(1,5)};self.pairs={'1':('a','c'),'2':('b','c'),'3':('a','d'),'4':('b','d')};items=[]
+  for pid,kind in [('a','dress'),('b','dress'),('c','hair'),('d','hair')]:
+   index=0 if kind=='dress' else 1;other=1-index;trans={s*32:t*32 for s,p in self.pairs.items() for t,q in self.pairs.items() if q[index]==pid and p[other]==q[other]};items.append({'part_id':pid*64,'kind':kind,'transitions':trans})
+  self.bindings={'schema':3,'catalog_sha256':'f'*64,'items':items,'inspect_only':True,'game_modified':False}
+ def test_new_part_extends_and_existing_is_reused(self):
+  dest,new=extend(self.bindings,self.tokens,'1'*32,'5'*32,'hair','e'*64);self.assertEqual(dest,'5'*32);self.assertEqual(len(new['items']),5)
+  item=next(x for x in new['items'] if x['part_id']=='a'*64);self.assertEqual(item['transitions']['5'*32],'5'*32)
+  dest,new=extend(self.bindings,self.tokens,'1'*32,'5'*32,'hair','d'*64);self.assertEqual(dest,'3'*32);self.assertIsNone(new)
+ def test_inconsistent_transitions_and_cross_slot_rejected(self):
+  self.bindings['items'][0]['transitions']['1'*32]='4'*32
+  with self.assertRaises(Refused):extend(self.bindings,self.tokens,'1'*32,'5'*32,'hair','e'*64)
+  self.setUp()
+  with self.assertRaises(Refused):extend(self.bindings,self.tokens,'1'*32,'5'*32,'hair','a'*64)
+if __name__=='__main__':unittest.main(verbosity=2)
