+"""Plan source-bound scene transitions for an explicitly prepared variation.
+
+Pure function. The trusted caller publishes its result under the scene lock
+only after successful frame verification. No game write or fidelity claim.
+"""
+import re
+from scene_switch_supervisor import TOKEN,Refused
+D=re.compile(r'[a-f0-9]{64}\Z')
+def extend(bindings,tokens,base,new,slot,part):
+ if type(bindings)is not dict or bindings.get('schema')!=3 or not isinstance(tokens,set) or not 1<=len(tokens)<=16 or base not in tokens or new in tokens or not isinstance(new,str) or not TOKEN.fullmatch(new) or slot not in ('dress','hair') or not isinstance(part,str) or not D.fullmatch(part):raise Refused('invalid binding extension')
+ rows=bindings.get('items');
+ if not isinstance(rows,list) or not 1<=len(rows)<=16:raise Refused('invalid bindings')
+ pairs={};kinds={}
+ for row in rows:
+  if type(row)is not dict or set(row)!={'part_id','kind','transitions'} or row['kind'] not in ('dress','hair') or not isinstance(row['part_id'],str) or not D.fullmatch(row['part_id']) or row['part_id'] in kinds or type(row['transitions'])is not dict:raise Refused('invalid binding row')
+  kinds[row['part_id']]=row['kind']
+ for token in tokens:
+  pair={}
+  for row in rows:
+   if row['transitions'].get(token)==token:
+    if row['kind'] in pair:raise Refused('ambiguous active part')
+    pair[row['kind']]=row['part_id']
+  if set(pair)!={'dress','hair'}:raise Refused('missing active part')
+  pairs[token]=pair
+ if len({(v['dress'],v['hair']) for v in pairs.values()})!=len(pairs):raise Refused('duplicate scene combination')
+ for row in rows:
+  other='hair' if row['kind']=='dress' else 'dress'
+  expected={source:target for source,a in pairs.items() for target,b in pairs.items() if b[row['kind']]==row['part_id'] and a[other]==b[other]}
+  if row['transitions']!=expected:raise Refused('inconsistent prior transitions')
+ if part in kinds and kinds[part]!=slot:raise Refused('part slot mismatch')
+ target={**pairs[base],slot:part};existing=next((t for t,p in pairs.items() if p==target),None)
+ if existing is not None:return existing,None
+ if len(tokens)>=16 or len(kinds)>=16 and part not in kinds:raise Refused('scene or part bound')
+ pairs[new]=target;kinds[part]=slot;items=[]
+ for pid,kind in sorted(kinds.items()):
+  other='hair' if kind=='dress' else 'dress';transitions={source:dest for source,a in pairs.items() for dest,b in pairs.items() if b[kind]==pid and a[other]==b[other]}
