+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Bind a trusted preparation's pinned CASP, mesh and diffuse to one descriptor.
+
+Requires reviewed preparation reports and trusted parent paths. The report hashes
+are identity checks, not proof of provenance, compatibility or native fidelity.
+No game writes; generated descriptors are for an isolated preview candidate.
+"""
+import argparse,hashlib,json,pathlib,re,sys
+root=pathlib.Path(__file__).resolve().parents[1];sys.path[:0]=[str(root/'inert-status-fixture/modules'),str(root/'rig-recovery/cc-materials/lrle-gpl')]
+from cas_resource_catalog import Package
+from casp_material import casp_material
+D=re.compile(r'[a-f0-9]{64}\Z')
+def read(path,digest,limit):
+ p=pathlib.Path(path)
+ if not D.fullmatch(digest) or p.is_symlink() or not p.is_file():raise ValueError('pinned regular file required')
+ with p.open('rb') as f:b=f.read(limit+1)
+ if len(b)>limit or hashlib.sha256(b).hexdigest()!=digest:raise ValueError('pin or extent mismatch')
+ return b
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--package',required=True);p.add_argument('--package-sha',required=True)
+ for name in ('resolution','mesh-report','material-report'):p.add_argument('--'+name,nargs=2,metavar=('PATH','SHA256'),required=True)
+ p.add_argument('--output',required=True);a=p.parse_args()
+ if not a.output or a.output in ('.','..') or pathlib.Path(a.output).name!=a.output:raise ValueError('single fresh output directory required')
+ src=pathlib.Path(a.package)
