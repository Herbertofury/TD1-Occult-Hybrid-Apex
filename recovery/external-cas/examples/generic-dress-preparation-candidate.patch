+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Prepare one CASP-declared top diffuse as a private 2048x4096 diagnostic atlas.
+
+No game writes, shaders, mip-chain or compatibility claim. Inputs are trusted;
+codec execution and filesystem traversal are not an OS sandbox.
+"""
+import argparse,hashlib,io,json,pathlib,re,sys
+from PIL import Image
+root=pathlib.Path(__file__).resolve().parents[1];sys.path[:0]=[str(root/'inert-status-fixture/modules'),str(root/'rig-recovery/cc-materials'),str(root/'rig-recovery/cc-materials/lrle-gpl')]
+from cas_resource_catalog import Package,tgi
+from casp_material import casp_material
+from rle2_adapter import to_dds
+from decode import decode
+DIGEST=re.compile(r'[a-f0-9]{64}\Z');CASP=re.compile(r'034AEECB:[0-9A-F]{8}:[0-9A-F]{16}\Z')
+def main():
+ ap=argparse.ArgumentParser();
+ for flag in ('package','package-sha','casp','casp-sha','texture-sha','output'):ap.add_argument('--'+flag,required=True)
+ a=ap.parse_args()
+ if not all(DIGEST.fullmatch(x) for x in (a.package_sha,a.casp_sha,a.texture_sha)) or not CASP.fullmatch(a.casp):raise ValueError('pinned identities required')
+ if not a.output or a.output in ('.','..') or pathlib.Path(a.output).name!=a.output:raise ValueError('single new output directory required')
+ path=pathlib.Path(a.package)
+ if path.is_symlink() or not path.is_file() or path.stat().st_size>64*1024*1024:raise ValueError('bounded regular package required')
+ pkg=Package(path,'mod')
+ if pkg.source_sha256!=a.package_sha or len(pkg.entries)>1024:raise ValueError('package pin/count')
+ ck=tuple(int(v,16) for v in a.casp.split(':'))
+ if ck not in pkg.entries:raise ValueError('CASP missing')
+ c=pkg.read_many([ck],max_total=1024*1024)[ck]
+ if hashlib.sha256(c).hexdigest()!=a.casp_sha:raise ValueError('CASP pin mismatch')
+ meta=casp_material(c);requested=meta['texture'];tk=tuple(int(v,16) for v in requested.split(':'));route='exact'
+ if tk not in pkg.entries and tk[0]==0x3453cf95:
+  alias=(0x2bc04edf,*tk[1:])
+  if alias in pkg.entries:tk=alias;route='lrle-same-group-instance'
+ if tk not in pkg.entries:raise ValueError('declared texture missing')
+ data=pkg.read_many([tk],max_total=32*1024*1024)[tk]
+ if hashlib.sha256(data).hexdigest()!=a.texture_sha:raise ValueError('texture pin mismatch')
+ if data[:8]==b'LRLEV002':im=decode(data);kind='LRLE V002'
+ elif data[:8]==b'DXT5RLE2':im=Image.open(io.BytesIO(to_dds(data))).convert('RGBA');kind='RLE2 BC3'
+ elif data[:4]==b'DDS ':im=Image.open(io.BytesIO(data)).convert('RGBA');kind='DDS'
+ else:raise ValueError('unsupported texture encoding')
+ if im.size not in ((1024,2048),(2048,4096)):raise ValueError('unsupported atlas dimensions')
+ im.load();im=im.convert('RGBA');source_size=im.size
+ if im.size!=(2048,4096):im=im.resize((2048,4096),Image.Resampling.NEAREST)
+ pixels=im.tobytes()
+ if len(pixels)!=2048*4096*4:raise ValueError('invalid atlas extent')
+ pkg.read_many([ck],max_total=1024*1024)
+ parent=root/'private-input-recovery'
+ if parent.is_symlink() or not parent.is_dir():raise ValueError('private parent unavailable')
+ out=parent/a.output;out.mkdir(mode=0o700,exist_ok=False)
+ with (out/'material.rgba').open('xb') as f:f.write(pixels)
+ report={'package_sha256':a.package_sha,'casp':a.casp,'casp_sha256':a.casp_sha,'requested_texture':requested,'resolved_texture':tgi(tk),'texture_sha256':a.texture_sha,'material_sha256':hashlib.sha256(pixels).hexdigest(),'source_dimensions':list(source_size),'output_dimensions':[2048,4096],'resampling':'nearest' if source_size!=(2048,4096) else 'none','format':kind,'route':route,'game_modified':False,'native_fidelity':'unverified'}
+ with (out/'report.json').open('x') as f:json.dump(report,f,indent=2)
+ print(json.dumps({'source_dimensions':source_size,'output_dimensions':[2048,4096],'resampling':report['resampling'],'game_modified':False,'native_fidelity':'unverified'}))
+if __name__=='__main__':main()
