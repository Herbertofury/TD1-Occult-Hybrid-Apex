+//! Single prepared dress bound to a pinned descriptor and exact local inputs.
+//! The trusted preparation parent must verify CASP/package provenance; this
+//! module verifies file identities, not source rights or game compatibility.
+use sha2::{Digest,Sha256};
+use std::{fs,io::Read,path::Path};
+#[derive(Debug)]
+pub struct GenericDress {pub id:String,pub order:u16,pub colors:Vec<u32>,pub material_sha:String,pub mesh_sha:String,pub descriptor_sha:String}
+fn digest(s:&str)->bool{s.len()==64&&s.bytes().all(|c|c.is_ascii_digit()||(b'a'..=b'f').contains(&c))}
+fn casp_id(s:&str)->bool{let b=s.as_bytes();b.len()==34&&&b[..9]==b"034AEECB:"&&b[17]==b':'&&b[9..17].iter().chain(b[18..].iter()).all(|c|c.is_ascii_digit()||(b'A'..=b'F').contains(c))}
+impl GenericDress {
+ pub fn parse(raw:&[u8],expected:&str)->Result<Self,&'static str>{
+  if raw.len()>4096||!digest(expected)||format!("{:x}",Sha256::digest(raw))!=expected{return Err("generic descriptor identity");}
+  let s=std::str::from_utf8(raw).map_err(|_|"generic descriptor encoding")?;
+  let lines:Vec<_>=s.lines().collect();if lines.len()!=7||lines[0]!="APX-GENERIC-DRESS-1"||!casp_id(lines[1]){return Err("generic descriptor shape");}
+  let order=lines[2].parse::<u16>().map_err(|_|"generic swatch order")?;
+  let colors:Vec<u32>=lines[3].split(',').map(|s|{if s.len()!=8||!s.bytes().all(|x|x.is_ascii_digit()||(b'a'..=b'f').contains(&x)){return Err("generic color");}u32::from_str_radix(s,16).map_err(|_|"generic color")}).collect::<Result<_,_>>()?;
+  if !(1..=8).contains(&colors.len())||!lines[4..7].iter().all(|x|digest(x)){return Err("generic descriptor bounds");}
+  Ok(Self{id:lines[1].into(),order,colors,material_sha:lines[4].into(),mesh_sha:lines[5].into(),descriptor_sha:expected.into()})
+ }
+ pub fn from_env()->Result<Option<Self>,Box<dyn std::error::Error>>{
+  match (std::env::var_os("APEX_GENERIC_DRESS"),std::env::var_os("APEX_GENERIC_DRESS_SHA256")){
+   (None,None)=>Ok(None),
+   (Some(path),Some(pin))=>{let path=Path::new(&path);let meta=fs::symlink_metadata(path)?;if !meta.file_type().is_file(){return Err("generic descriptor regular file required".into())};let mut raw=Vec::new();fs::File::open(path)?.take(4097).read_to_end(&mut raw)?;Ok(Some(Self::parse(&raw,pin.to_str().ok_or("descriptor pin encoding")?)?))},
+   _=>Err("generic dress descriptor and SHA must be supplied together".into())
+  }
+ }
+ pub fn check_assets(&self,material:&[u8],mesh:&[u8])->Result<(),&'static str>{if format!("{:x}",Sha256::digest(material))!=self.material_sha||format!("{:x}",Sha256::digest(mesh))!=self.mesh_sha{return Err("generic dress asset identity");}Ok(())}
+ pub fn entry_json(&self)->String{let colors=self.colors.iter().map(u32::to_string).collect::<Vec<_>>().join(",");format!("{{\"id\":\"{}\",\"order\":{},\"colors_argb\":[{}],\"width\":2048,\"height\":4096}}",self.id,self.order,colors)}
+}
+#[cfg(test)] mod tests{
+ use super::*;
+ fn raw()->Vec<u8>{format!("APX-GENERIC-DRESS-1\n034AEECB:80000000:0123456789ABCDEF\n5\nff404f40,ffcb9f50\n{}\n{}\n{}\n","a".repeat(64),"b".repeat(64),"c".repeat(64)).into_bytes()}
+ #[test] fn rejects_bad_id_pin_colors_and_extent(){let x=raw();let h=format!("{:x}",Sha256::digest(&x));assert!(GenericDress::parse(&x,&h).is_ok());assert!(GenericDress::parse(&x,&"0".repeat(64)).is_err());for changed in [String::from_utf8(x.clone()).unwrap().replace("034AEECB","../bad!!"),String::from_utf8(x.clone()).unwrap().replace("ff404f40","gg404f40"),String::from_utf8(x.clone()).unwrap()+"extra\n"]{let h=format!("{:x}",Sha256::digest(changed.as_bytes()));assert!(GenericDress::parse(changed.as_bytes(),&h).is_err());}}
+}
