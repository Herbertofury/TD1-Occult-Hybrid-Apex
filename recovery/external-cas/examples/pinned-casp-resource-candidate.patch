+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Inspect one selected, pinned CASP's declared resources in its own package.
+
+Private research only. No external resource search, renderer or game writes.
+A resolved reference is not a compatibility or native-game claim. This is not a
+sandbox for hostile packages. Dependencies are separately retained GPL tools.
+"""
+import argparse,hashlib,json,pathlib,re,sys
+root=pathlib.Path(__file__).resolve().parents[1];sys.path[:0]=[str(root/'inert-status-fixture/modules'),str(root/'rig-recovery/cc-materials/lrle-gpl')]
+from cas_resource_catalog import Package,tgi
+from casp_material import casp_material
+HEX=re.compile(r'[a-f0-9]{64}\Z');CASP=re.compile(r'034AEECB:[0-9A-F]{8}:[0-9A-F]{16}\Z')
+def main():
+ ap=argparse.ArgumentParser();ap.add_argument('--package',required=True);ap.add_argument('--package-sha',required=True);ap.add_argument('--casp',required=True);ap.add_argument('--casp-sha',required=True);ap.add_argument('--output',required=True);a=ap.parse_args()
+ if not HEX.fullmatch(a.package_sha) or not HEX.fullmatch(a.casp_sha) or not CASP.fullmatch(a.casp):raise ValueError('identity required')
+ if not a.output or a.output in ('.','..') or pathlib.Path(a.output).name!=a.output:raise ValueError('single output directory name required')
+ path=pathlib.Path(a.package)
+ if path.is_symlink() or not path.is_file() or path.stat().st_size>64*1024*1024:raise ValueError('bounded regular package required')
+ package=Package(path,'mod')
+ if package.source_sha256!=a.package_sha or len(package.entries)>1024:raise ValueError('package pin or count mismatch')
+ key=tuple(int(v,16) for v in a.casp.split(':'))
+ if key not in package.entries:raise ValueError('CASP missing')
+ raw=package.read_many([key],max_total=1024*1024)[key]
+ if hashlib.sha256(raw).hexdigest()!=a.casp_sha:raise ValueError('CASP pin mismatch')
+ meta=casp_material(raw);refs=[];seen=set()
+ for role,ref in [('texture',meta['texture']),*[(f"lod-{lod['lod']}",geom) for lod in meta['lods'] for geom in lod['geometries']]]:
+  if (role,ref) in seen:raise ValueError('duplicate source reference')
+  seen.add((role,ref));parts=tuple(int(v,16) for v in ref.split(':'));resolved=parts;route='exact'
+  if resolved not in package.entries and role=='texture' and parts[0]==0x3453cf95:
+   alternate=(0x2bc04edf,*parts[1:])
+   if alternate in package.entries:resolved=alternate;route='lrle-same-group-instance'
+  if resolved not in package.entries:refs.append({'role':role,'requested':ref,'state':'missing-in-package'});continue
+  b=package.read_many([resolved],max_total=32*1024*1024)[resolved]
+  refs.append({'role':role,'requested':ref,'resolved':tgi(resolved),'route':route,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest(),'state':'source-present-not-rendered'})
+ if len(refs)>128:raise ValueError('too many references')
+ # Re-reading through the package's pinned checks detects source mutation.
+ package.read_many([key],max_total=1024*1024)
+ parent=root/'private-input-recovery'
+ if parent.is_symlink() or not parent.is_dir():raise ValueError('private parent unavailable')
+ out=parent/a.output;out.mkdir(mode=0o700,exist_ok=False)
+ result={'package_sha256':a.package_sha,'casp':a.casp,'casp_sha256':a.casp_sha,'casp_version':meta['version'],'body_type':meta['body_type'],'swatch_order':meta['swatch_order'],'references':refs,'game_modified':False,'rendered':False,'compatibility':'unverified'}
+ with (out/'resolution.json').open('x') as f:json.dump(result,f,indent=2)
+ print(json.dumps({'casp_version':meta['version'],'references':len(refs),'present':sum(x['state']=='source-present-not-rendered' for x in refs),'game_modified':False,'rendered':False}))
+if __name__=='__main__':main()
