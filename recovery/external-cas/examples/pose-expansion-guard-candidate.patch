+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Synthetic-only CLI tests. Creates and removes only its own temporary files."""
+import hashlib,json,pathlib,shutil,struct,subprocess,sys,tempfile,unittest,uuid
+ROOT=pathlib.Path(__file__).resolve().parents[1];SCRIPT=ROOT/'real-recovery-evidence/intake_pose_package.py';DEST=ROOT/'private-input-recovery';sys.path.insert(0,str(SCRIPT.parent));from intake_pose_package import estimated_keys
+class IntakeTests(unittest.TestCase):
+ def setUp(self):
+  self.temp=tempfile.TemporaryDirectory(prefix='pose-intake-test-');self.src=pathlib.Path(self.temp.name)/'empty.package';h=[0]*24;h[0]=0x46504244;h[1]=2;h[2]=1;self.src.write_bytes(struct.pack('<24I',*h));self.sha=hashlib.sha256(self.src.read_bytes()).hexdigest();self.name='test-'+uuid.uuid4().hex;self.output=DEST/self.name
+ def tearDown(self):
+  if self.output.exists():shutil.rmtree(self.output)
+  self.temp.cleanup()
+ def run_cli(self,*args):return subprocess.run([sys.executable,'-O',str(SCRIPT),str(self.src),*args],capture_output=True,text=True,timeout=10)
+ def test_valid_empty_and_repeat_refuses_without_touching_last_good(self):
+  run=self.run_cli(self.sha,self.name);self.assertEqual(run.returncode,0,run.stderr);report=json.loads(run.stdout);self.assertEqual(report['resources'],0);self.assertFalse(report['clip_decoding_complete']);self.assertFalse(report['game_modified']);prior=(self.output/'intake-report.json').read_bytes();again=self.run_cli(self.sha,self.name);self.assertNotEqual(again.returncode,0);self.assertEqual((self.output/'intake-report.json').read_bytes(),prior)
+ def test_wrong_hash_and_unsafe_name_refused_before_output(self):
+  self.assertNotEqual(self.run_cli('0'*64,self.name).returncode,0);self.assertFalse(self.output.exists());self.assertNotEqual(self.run_cli(self.sha,'../escape').returncode,0);self.assertFalse(self.output.exists())
+ def test_clip_preflight_refuses_large_or_truncated_tables(self):
+  def clip(count,frames):
+   b=bytearray(48+count*20);b[:8]=b'_pilC3S_';struct.pack_into('<I',b,24,count);struct.pack_into('<I',b,32,48)
+   for i in range(count):struct.pack_into('<H',b,48+i*20+16,frames)
+   return bytes(b)
+  self.assertEqual(estimated_keys(clip(2,7)),14)
+  with self.assertRaises(ValueError):estimated_keys(clip(2,60000))
+  with self.assertRaises(ValueError):estimated_keys(clip(2049,0))
+  with self.assertRaises(ValueError):estimated_keys(clip(2,1)[:-1])
+ def test_invalid_package_and_symlink_refused(self):
+  self.src.write_bytes(b'not a package');h=hashlib.sha256(self.src.read_bytes()).hexdigest();self.assertNotEqual(self.run_cli(h,self.name).returncode,0);self.assertFalse(self.output.exists());link=pathlib.Path(self.temp.name)/'link.package';link.symlink_to(self.src);r=subprocess.run([sys.executable,str(SCRIPT),str(link),h,self.name],capture_output=True,timeout=10);self.assertNotEqual(r.returncode,0);self.assertFalse(self.output.exists())
+if __name__=='__main__':unittest.main(verbosity=2)
