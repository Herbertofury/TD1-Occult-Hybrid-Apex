+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Synthetic process ownership tests, not game or crash-containment proof."""
+import threading,time,unittest
+from unittest import mock
+from preparation_owner import PreparationOwner
+S={'catalog':'/trusted/catalog','catalog_sha':'a'*64,'part_id':'b'*64,'package':'/trusted/package','rig':'/trusted/rig','rig_sha':'c'*64,'name':'run-one'}
+class Process:
+ def __init__(self):self.event=threading.Event()
+ def wait(self,timeout=None):self.event.wait(2);return 0
+class Tests(unittest.TestCase):
+ def test_explicit_start_single_job_no_paths_or_retries(self):
+  q=Process();o=PreparationOwner({'1'*32:S})
+  with mock.patch('preparation_owner.subprocess.Popen',return_value=q) as spawn:
+   self.assertIsNone(o.status());self.assertEqual(spawn.call_count,0);job=o.start('1'*32);self.assertEqual(job['state'],'running')
+   with self.assertRaises(ValueError):o.start('1'*32)
+   with self.assertRaises(ValueError):o.close()
+   self.assertNotIn('/trusted',str(o.status()));q.event.set()
+   deadline=time.monotonic()+2
+   while o.status()['state']=='running' and time.monotonic()<deadline:time.sleep(.005)
+   self.assertEqual(o.status()['state'],'prepared');o.acknowledge(job['id'])
+   with self.assertRaises(ValueError):o.start('1'*32)
+   o.close();self.assertEqual(spawn.call_count,1)
+ def test_failure_is_visible_and_not_retried(self):
+  class Bad:
+   def wait(self,timeout=None):return 1
+  o=PreparationOwner({'1'*32:S})
+  with mock.patch('preparation_owner.subprocess.Popen',return_value=Bad()) as spawn:
+   job=o.start('1'*32);deadline=time.monotonic()+2
+   while o.status()['state']=='running' and time.monotonic()<deadline:time.sleep(.005)
+   self.assertEqual(o.status()['state'],'failed');o.acknowledge(job['id'])
+   with self.assertRaises(ValueError):o.start('1'*32)
+   self.assertEqual(spawn.call_count,1);o.close()
+ def test_timeout_terminates_child_and_reports_failure(self):
+  import subprocess
+  class Slow:
+   def __init__(self):self.calls=0;self.terminated=False
+   def wait(self,timeout=None):
+    self.calls+=1
+    if self.calls==1:raise subprocess.TimeoutExpired('candidate',timeout)
+    return 0
+   def terminate(self):self.terminated=True
+  q=Slow();o=PreparationOwner({'1'*32:S})
+  with mock.patch('preparation_owner.subprocess.Popen',return_value=q):
+   job=o.start('1'*32);deadline=time.monotonic()+2
+   while o.status()['state']=='running' and time.monotonic()<deadline:time.sleep(.005)
+   self.assertEqual(o.status()['state'],'timed_out');self.assertTrue(q.terminated);o.acknowledge(job['id']);o.close()
+ def test_invalid_tokens_paths_and_duplicate_names_refused(self):
+  for entries in [{'bad':S},{'1'*32:{**S,'package':'relative'}},{'1'*32:S,'2'*32:S}]:
+   with self.assertRaises(ValueError):PreparationOwner(entries)
+if __name__=='__main__':unittest.main(verbosity=2)
