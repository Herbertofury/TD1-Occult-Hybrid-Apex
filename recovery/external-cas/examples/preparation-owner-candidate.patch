+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Bounded private single-job owner for trusted, pre-registered CAS selections.
+
+No HTTP surface, arbitrary browser-supplied paths, game write or native equip.
+Only an explicitly registered pinned local package, catalog and rig is used.
+Caller must keep ownership alive; abrupt-death containment is not guaranteed.
+"""
+import pathlib,re,subprocess,sys,threading,uuid
+from scene_switch_supervisor import TOKEN,HASH
+ROOT=pathlib.Path(__file__).resolve().parent
+NAME=re.compile(r'[a-z0-9][a-z0-9-]{0,15}\Z')
+class PreparationOwner:
+ def __init__(self,selections):
+  if type(selections)is not dict or not 1<=len(selections)<=64:raise ValueError('bounded trusted selections required')
+  self.selections={}
+  for token,v in selections.items():
+   if not isinstance(token,str) or not TOKEN.fullmatch(token) or type(v)is not dict or set(v)!={'catalog','catalog_sha','part_id','package','rig','rig_sha','name'}:raise ValueError('selection shape')
+   if not all(isinstance(v[k],str) and pathlib.Path(v[k]).is_absolute() for k in ('catalog','package','rig')) or not all(isinstance(v[k],str) and HASH.fullmatch(v[k]) for k in ('catalog_sha','part_id','rig_sha')) or not isinstance(v['name'],str) or not NAME.fullmatch(v['name']):raise ValueError('selection identity')
+   self.selections[token]=dict(v)
+  if len({v['name'] for v in self.selections.values()})!=len(self.selections):raise ValueError('duplicate output name')
+  self.lock=threading.RLock();self.job=None;self.child=None;self.closed=False;self.used=set()
+ def status(self):
+  with self.lock:return None if self.job is None else dict(self.job)
+ def start(self,token):
+  with self.lock:
+   if self.closed or self.job is not None or token not in self.selections or token in self.used:raise ValueError('selection unavailable or owner busy')
+   s=self.selections[token];self.used.add(token);job=uuid.uuid4().hex;self.job={'id':job,'selection':token,'state':'running'}
+   thread=threading.Thread(target=self._run,args=(job,s),daemon=True);thread.start();return dict(self.job)
+ def _run(self,job,s):
+  args=[sys.executable,str(ROOT/'prepare_catalog_selection.py'),'--catalog',s['catalog'],s['catalog_sha'],'--part-id',s['part_id'],'--package',s['package'],'--rig',s['rig'],s['rig_sha'],'--name',s['name']]
+  state='failed'
+  try:
+   proc=subprocess.Popen(args,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,env={'PATH':'/usr/bin:/bin'})
+   with self.lock:self.child=proc
+   try:state='prepared' if proc.wait(timeout=1200)==0 else 'failed'
+   except subprocess.TimeoutExpired:
+    proc.terminate()
+    try:proc.wait(timeout=5)
+    except subprocess.TimeoutExpired:proc.kill();proc.wait(timeout=5)
+    state='timed_out'
+  except Exception:state='failed'
+  finally:
+   with self.lock:
+    self.child=None
+    if self.job and self.job['id']==job:self.job={**self.job,'state':state}
+ def acknowledge(self,job):
+  with self.lock:
+   if not self.job or self.job['id']!=job or self.job['state']=='running':raise ValueError('job unavailable or still running')
+   # No retry or deletion: the caller must register a new unused output name.
+   self.job=None
+ def close(self):
+  with self.lock:
+   if self.job and self.job['state']=='running':raise ValueError('job still running')
+   self.closed=True
