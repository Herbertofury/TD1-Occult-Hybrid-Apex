+// Opt-in loopback client integration. No browser, game or native-save claim.
+import assert from 'node:assert/strict';
+import {validateCatalog} from './pose-model.mjs';
+import {validateSwatchCatalog} from './swatch-model.mjs';
+import {validateAccessoryCatalog} from './accessory-model.mjs';
+import {createFrameClient} from './frame-client.mjs';
+const [base,id]=process.argv.slice(2);
+assert.match(base,/^http:\/\/127\.0\.0\.1:\d+$/);assert.match(id,/^[a-f0-9]{64}$/);
+const local=(path,opts)=>fetch(base+path,opts);
+async function json(path){const r=await local(path);assert.equal(r.status,200);return r.json();}
+const swatches=validateSwatchCatalog(await json('/swatch-catalog'));
+const accessories=validateAccessoryCatalog(await json('/accessory-catalog'));
+const catalog=validateCatalog(await json('/pose-catalog'));
+assert.equal(swatches.scene_sha256,accessories.scene_sha256);
+const pose=catalog.poses.find(p=>p.id===id);assert.equal(pose.playback_ready,true);assert.equal(catalog.autoplay,false);
+const client=createFrameClient({mode:'clip',fetchImpl:local,timeoutMs:30000});
+const frame=await client.read({clipId:id,frame:0,yaw:0,brightness:0,saturation:0,hue:0,opacity:16384,swatchId:swatches.default_id,catalogScene:swatches.scene_sha256});
+assert.equal(frame.scene,swatches.scene_sha256);assert.equal(frame.rgba.length,512*512*4);
+console.log(JSON.stringify({poseCount:catalog.poses.length,swatches:swatches.swatches.length,accessoriesEnabled:accessories.enabled,clientFrameBytes:frame.rgba.length,autoplay:false,browserTested:false,gameModified:false}));
