+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Validate owner-pinned source pipelines for each private prepared scene.
+
+Only trusted private parent configuration, no browser-supplied paths. Provenance
+proves exact staged bytes, not game compatibility or rights.
+"""
+import json
+from build_scene_bindings import pin,PRIVATE,N
+from scene_switch_supervisor import Refused
+
+def validate(specs,rows):
+ if type(rows)is not dict or set(rows)!=set(specs) or not 1<=len(rows)<=16:raise Refused('scene provenance mismatch')
+ result={}
+ for token,row in rows.items():
+  if type(row)is not dict or set(row)!={'dress','hair'} or not all(isinstance(v,str) and N.fullmatch(v) for v in row.values()):raise Refused('pipeline names')
+  spec=specs[token];base=PRIVATE/spec['runtime'];marker=base/'runtime.json';pin(marker,spec['runtime_sha'],1024*1024);m=json.loads(marker.read_bytes());ready={}
+  for slot,name in row.items():
+   path=PRIVATE/(name+'-ready')/'ready.json'
+   if path.is_symlink() or not path.is_file() or path.stat().st_size>65536:raise Refused('pipeline unavailable')
+   ready[slot]=json.loads(path.read_bytes())
+   if ready[slot].get('game_modified') is not False or ready[slot].get('mesh_sha256')!=m.get('mesh_hashes',{}).get(slot+'.apxmesh'):raise Refused('pipeline mesh differs')
+  dress,hair=ready['dress'],ready['hair'];source=m.get('hair_source')
+  if dress.get('descriptor_sha256')!=m.get('descriptor_sha256') or dress.get('material_sha256')!=m.get('material_sha256') or type(source)is not dict or any(source.get(k)!=hair.get(k) for k in ('package_sha256','casp','casp_sha256','mesh_sha256','material_sha256')):raise Refused('pipeline material or source differs')
+  result[token]=dict(row)
+ return result
