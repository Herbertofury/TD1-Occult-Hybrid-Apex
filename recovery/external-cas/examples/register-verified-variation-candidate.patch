+# SPDX-License-Identifier: GPL-3.0-or-later
+import threading,unittest
+from unittest.mock import patch
+from scene_switch_supervisor import Refused
+from register_prepared_variant import register
+C={'index':'/safe/index','index_sha':'d'*64,'helper':'/safe/helper','helper_sha':'e'*64,'policy':'sha256-per-request'}
+S={'runtime':'base','runtime_sha':'a'*64,'binary':'/safe/bin','binary_sha':'b'*64,'scene_sha':'c'*64,'swatch_id':'034AEECB:80000000:0123456789ABCDEF','catalog':C}
+class Owner:
+ def __init__(self):self.lock=threading.RLock();self.specs={'1'*32:S};self.generation=4;self.fail=False
+ def status(self):return {'state':'ready','token':'1'*32,'generation':self.generation}
+ def switch_if(self,token,generation):
+  if self.fail:raise Refused('invalid frame')
+  self.generation+=1;return {'token':token,'generation':self.generation}
+class Tests(unittest.TestCase):
+ def test_only_matching_base_registers_and_switches(self):
+  o=Owner();labels={'1'*32:'Base'};result=register(o,labels,base_token='1'*32,generation=4,token='2'*32,spec=S,label='Prepared');self.assertEqual(result['token'],'2'*32);self.assertEqual(labels['2'*32],'Prepared')
+ def test_stale_catalog_and_failed_frame_leave_no_variant(self):
+  for stale,catalog,fail in [(True,C,False),(False,{**C,'index_sha':'f'*64},False),(False,C,True)]:
+   o=Owner();o.fail=fail;labels={'1'*32:'Base'}
+   with self.assertRaises(Refused):register(o,labels,base_token='1'*32,generation=3 if stale else 4,token='2'*32,spec={**S,'catalog':catalog},label='Prepared')
+   self.assertNotIn('2'*32,o.specs);self.assertNotIn('2'*32,labels)
+if __name__=='__main__':unittest.main(verbosity=2)
