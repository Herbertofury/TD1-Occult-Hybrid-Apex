+  path=PRIVATE/(name+'-ready')/'ready.json'
+  if path.is_symlink() or not path.is_file() or path.stat().st_size>65536:raise ValueError('prepared source unavailable')
+  v=json.loads(path.read_bytes());ensure_mesh_compatibility(m,slot,v);heads.append(v)
+ catalog=base/'poses'/'catalog.json';pin(catalog,m['pose_catalog_sha256'],1024*1024);pin(marker,a.base_sha,1024*1024);binary=pathlib.Path(a.binary[0]);pin(binary,a.binary[1],64*1024*1024)
+ args=[sys.executable,str(ROOT/'rig-recovery/stage_generic_runtime.py'),'--baseline',str(base/'assets'),'--manifest',*a.manifest,'--head',str(base/'head.apxmesh'),'--shoes',str(base/'shoes.apxmesh'),'--hair',str(base/'hair.apxmesh'),'--pipeline',a.dress_pipeline,'--hair-pipeline',a.hair_pipeline,'--pose-library',str(base/'poses'),'--pose-catalog-sha',m['pose_catalog_sha256'],'--output',a.output]
