+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Atomically register and frame-verify a trusted same-mesh preview variant.
+
+This private helper does not accept browser paths or authorize native writes.
+The parent supplies the pinned specification, catalog and base generation.
+"""
+from scene_switch_supervisor import SceneSwitcher,Refused,TOKEN
+def register(owner,labels,*,base_token,generation,token,spec,label):
+ if not isinstance(token,str) or not TOKEN.fullmatch(token) or not isinstance(base_token,str) or not TOKEN.fullmatch(base_token) or type(generation)is not int or not isinstance(label,str) or not 1<=len(label)<=80 or any(ord(c)<32 or ord(c)==127 for c in label):raise Refused('invalid trusted variant identity')
+ probe=SceneSwitcher({token:spec});probe.close() # Validate the full trusted spec before mutation.
+ with owner.lock:
+  state=owner.status()
+  if state.get('state')!='ready' or state.get('token')!=base_token or state.get('generation')!=generation or token in owner.specs or token in labels or len(owner.specs)>=16:raise Refused('stale base or full scene set')
+  if spec.get('catalog')!=owner.specs[base_token].get('catalog') or spec.get('catalog') is None:raise Refused('catalog differs from active base')
+  owner.specs[token]=probe.specs[token];labels[token]=label
+  try:return owner.switch_if(token,generation)
+  except BaseException:
+   del owner.specs[token];del labels[token];raise
