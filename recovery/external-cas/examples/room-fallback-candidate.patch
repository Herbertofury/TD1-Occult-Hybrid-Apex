+import {CcHistory,CC_DEFAULTS} from './cc-history.mjs';
+import {loadCcHistory,saveCcHistory} from './cc-history-session.mjs';
+import {createFrameClient} from './frame-client.mjs';
+import {PreviewController} from './controller.mjs';
+
+// Explicit selected-CC fallback. Never pretends that native pose, outfit, or
+// game application is available; this is the existing read-only renderer.
+export function startRoomFallback(doc,win,storage){
+ const $=s=>doc.querySelector(s),canvas=$('canvas'),ctx=canvas.getContext('2d');
+ const names=['yaw','hue','brightness','saturation','opacity'];
+ const history=new CcHistory(),client=createFrameClient({mode:'cc',timeoutMs:15000});
+ let scene=null,ready=false,error='',reopen=false;
+ const fields=()=>Object.fromEntries(names.map(n=>[n,Number($('#'+n).value)]));
+ function save(){if(!ready)return;try{saveCcHistory(history,storage,scene);error='';}catch(e){ready=false;error='Tab recovery unavailable: '+e.message;}}
+ function sync(){
+  $('#undo-pose').disabled=!history.canUndo;$('#redo-pose').disabled=history.pending||history.branches.length===0;
+  $('#pose-branches').replaceChildren(...history.branches.map(b=>{let o=doc.createElement('option');o.value=String(b.id);o.textContent='Preview edit '+b.id;return o;}));
+  if(history.branches.length)$('#pose-branches').value=String(history.branches.at(-1).id);
+  $('#pose-branches').disabled=$('#redo-pose').disabled;
+  $('#pose-history-status').textContent=`Preview history ${history.nodes.length}/${history.capacity}. No game or outfit writes. ${error}`;
+ }
+ function restore(){for(const n of names)$('#'+n).value=String(history.value[n]);sync();controller.request(history.value);}
+ const controller=new PreviewController(r=>client.read(r),(frame,r)=>{
+  if(scene!==null&&scene!==frame.scene)throw Error('Preview scene changed');
+  ctx.putImageData(new ImageData(frame.rgba,512,512),0,0);
+  if(scene===null){scene=frame.scene;try{let recovered=loadCcHistory(history,storage,scene);ready=true;if(recovered)queueMicrotask(restore);}catch(e){error='Tab recovery unavailable: '+e.message;}
+   for(const n of names)$('#'+n).disabled=false;$('#reset-material').disabled=false;sync();}
+  canvas.setAttribute('aria-label','Selected CC diagnostic preview; no native pose');canvas.dataset.scene=frame.scene;canvas.dataset.parameters=JSON.stringify(r);
+  $('#identity').textContent=`${frame.harness} · scene ${frame.scene}`;$('#metrics').textContent=`Render ${frame.cpuMs??'?'} ms · request ${frame.fetchMs.toFixed(1)} ms. Offline diagnostic; not game FPS.`;
+ },message=>{$('#frame-status').textContent='Pose library unavailable. Selected CC preview: '+message;});
+ for(const n of names){let input=$('#'+n);input.addEventListener('input',()=>{try{history.stage({...history.value,...fields()});sync();controller.request(history.value);}catch(e){error=e.message;sync();}});input.addEventListener('change',()=>{try{history.commit();save();sync();}catch(e){error=e.message;restore();}});}
+ $('#undo-pose').addEventListener('click',()=>{history.undo();save();restore();});
+ $('#redo-pose').addEventListener('click',()=>{try{history.redo(Number($('#pose-branches').value));save();restore();}catch(e){error=e.message;sync();}});
+ $('#reset-material').addEventListener('click',()=>{try{history.stage({...history.value,hue:0,brightness:0,saturation:0,opacity:16384});history.commit();save();restore();}catch(e){error=e.message;sync();}});
+ for(const n of ['search','pack','creator','kind','availability','pinned-only','loop','playback-rate'])$('#'+n).disabled=true;
+ const unavailable=doc.createElement('option');unavailable.textContent='Pose library unavailable';unavailable.value='';$('#pose-select').replaceChildren(unavailable);
+ $('#swatch-status').textContent='Prepared swatch selection is unavailable in this fallback; default selected CC remains visible.';
+ $('#accessory-status').textContent='Prepared accessory selection is unavailable in this fallback.';
+ $('#undo-pose').setAttribute('aria-label','Undo preview edit');$('#redo-pose').setAttribute('aria-label','Redo preview edit');
+ $('#selected-title').textContent='Selected CC preview';$('#selected-detail').textContent='Pose library is unavailable; showing neutral rig diagnostic.';$('#play-state').textContent='Pose unavailable';
+ win.addEventListener('pagehide',()=>{reopen=controller.opened;controller.close();});win.addEventListener('pageshow',e=>{if(e.persisted&&reopen){reopen=false;controller.open();restore();}});
+ controller.open();restore();return {controller,history};
+}
