+// Bounded preview-only history. The private scene and fixed catalog own every ID.
+import {PreviewHistory,CC_DEFAULTS} from './cc-history.mjs';
+const fields=['yaw','pose','brightness','saturation','hue','opacity'];
+const limits={yaw:[-180,180],pose:[-90,90],brightness:[-8192,8192],saturation:[-8192,8192],hue:[-8192,8192],opacity:[3277,16384]};
+const DIGEST=/^[a-f0-9]{64}$/;
+export class CcSwatchHistory extends PreviewHistory {
+ constructor(catalog,capacity=128){
+  if(!catalog?.enabled||!DIGEST.test(catalog.scene_sha256)||!DIGEST.test(catalog.catalog_sha256))throw Error('Verified swatch catalog required');
+  const ids=new Set(catalog.swatches.map(s=>s.id));if(!ids.has(catalog.default_id))throw Error('Default swatch missing');
+  const checked=v=>{if(!v||Object.keys(v).length!==7||!ids.has(v.swatchId))throw Error('Invalid swatch preview');for(const k of fields){const [min,max]=limits[k];if(!Number.isInteger(v[k])||v[k]<min||v[k]>max)throw Error('Invalid preview '+k);}return Object.freeze({...v});};
+  const same=(a,b)=>fields.every(k=>a[k]===b[k])&&a.swatchId===b.swatchId;
+  super({...CC_DEFAULTS,swatchId:catalog.default_id},capacity,{checked,same});
+ }
+ migrateLegacy(legacy,defaultId){const state=legacy.exportState();state.nodes=state.nodes.map(n=>({...n,value:{...n.value,swatchId:defaultId}}));this.restoreState(state);}
+}
+const LIMIT=65536,owners=new WeakMap();
+function key(scene,catalog){if(!DIGEST.test(scene)||!DIGEST.test(catalog))throw Error('Verified scene and catalog required');return 'apex.cc-swatch-preview.v1.'+scene+'.'+catalog;}
+export function loadSwatchHistory(history,storage,scene,catalog){const name=key(scene,catalog),raw=storage.getItem(name);if(raw!==null){if(typeof raw!=='string'||raw.length>LIMIT)throw Error('Retained swatch history exceeds limit');history.restoreState(JSON.parse(raw));}owners.set(history,{storage,name,raw});return raw!==null;}
+export function saveSwatchHistory(history,storage,scene,catalog){const name=key(scene,catalog),prior=owners.get(history),current=storage.getItem(name);if(!prior||prior.storage!==storage||prior.name!==name||prior.raw!==current)throw Error('Retained swatch history changed; refusing overwrite');const raw=JSON.stringify(history.exportState());if(raw.length>LIMIT)throw Error('Swatch history exceeds limit');storage.setItem(name,raw);if(storage.getItem(name)!==raw)throw Error('Swatch history readback changed');owners.set(history,{storage,name,raw});}
