+fn parse_cc_frame(path: &str) -> Option<(Vec<i32>, &str)> {
+    let mut params: Vec<_> = path.strip_prefix("/cc-frame?")?.split('&').collect();
+    let swatch = if params.last().is_some_and(|p| p.starts_with("swatch=")) {
+        params.pop()?.strip_prefix("swatch=")?
+    } else { cc_scene::swatch_catalog::DEFAULT_ID };
+    cc_scene::swatch_catalog::find(swatch).ok()?;
+    if params.len() != 5 && params.len() != 6 { return None; }
+    let names = ["yaw=", "brightness=", "saturation=", "hue=", "opacity=", "pose="];
+    let values = params.iter().zip(names).map(|(p,n)| p.strip_prefix(n)?.parse::<i32>().ok()).collect::<Option<Vec<_>>>()?;
+    Some((values, swatch))
+}
