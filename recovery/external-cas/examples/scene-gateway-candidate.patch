+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Run an experimental loopback-only CAS scene picker from pinned local config.
+
+Config and runtime files must be trusted and prebound by the owner. This is not
+an installer, browser security boundary, native game integration or Tray export.
+SIGTERM/interrupt attempts cleanup; SIGKILL/power-loss containment is unproven.
+"""
+import argparse,hashlib,json,pathlib,signal,sys
+from scene_gateway import Gateway
+from scene_switch_supervisor import SceneSwitcher,TOKEN
+D=__import__('re').compile(r'[a-f0-9]{64}\Z')
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--config',required=True);p.add_argument('--config-sha',required=True);a=p.parse_args();src=pathlib.Path(a.config)
+ if not D.fullmatch(a.config_sha) or src.is_symlink() or not src.is_file() or src.stat().st_size>65536:raise ValueError('pinned config required')
+ with src.open('rb') as f:raw=f.read(65537)
+ if hashlib.sha256(raw).hexdigest()!=a.config_sha:raise ValueError('config identity')
+ obj=json.loads(raw)
+ if type(obj)is not dict or set(obj)!={'schema','initial','scenes'} or obj['schema']!=1 or type(obj['scenes'])is not dict or obj['initial'] not in obj['scenes']:raise ValueError('config shape')
+ specs={};labels={}
+ for token,row in obj['scenes'].items():
+  if not isinstance(token,str) or not TOKEN.fullmatch(token) or type(row)is not dict or set(row)!={'label','spec'}:raise ValueError('scene config')
+  specs[token]=row['spec'];labels[token]=row['label']
+ owner=SceneSwitcher(specs);gateway=None
+ def interrupt(signum,frame):raise KeyboardInterrupt()
+ old=signal.signal(signal.SIGTERM,interrupt)
+ try:
+  owner.switch(obj['initial']);gateway=Gateway(owner,labels)
+  print(f'http://{gateway.expected_host}/cas-room',flush=True);gateway.serve_forever(poll_interval=.25)
+ except KeyboardInterrupt:pass
+ finally:
+  if gateway:gateway.server_close()
+  owner.close();signal.signal(signal.SIGTERM,old)
+if __name__=='__main__':main()
