+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Pure ownership failure tests; real process check is separately opt-in."""
+import sys,unittest
+from unittest.mock import patch
+sys.path.insert(0,__import__('pathlib').Path(__file__).resolve().parent.as_posix())
+import scene_switch_supervisor as m
+S={'runtime':'sample','runtime_sha':'a'*64,'binary':'/trusted/preview','binary_sha':'b'*64,'scene_sha':'c'*64,'swatch_id':'034AEECB:80000000:0123456789ABCDEF'}
+class Out:
+ def __init__(self):self.closed=False
+ def close(self):self.closed=True
+class Fake:
+ def __init__(self):self.stdout=Out()
+ def poll(self):return None
+class Tests(unittest.TestCase):
+ def test_untrusted_selection_never_spawns(self):
+  s=m.SceneSwitcher({'1'*32:S})
+  with patch.object(m.subprocess,'Popen') as p:
+   with self.assertRaises(m.Refused):s.switch('2'*32)
+   p.assert_not_called()
+  s.close();self.assertEqual(s.status()['state'],'closed')
+ def test_cleanup_failure_retains_owner_and_gates_transport(self):
+  s=m.SceneSwitcher({'1'*32:S});p=Fake();s.active={'token':'1'*32,'scene':'c'*64,'url':'http://127.0.0.1:1','proc':p}
+  with patch.object(m,'stop',side_effect=[OSError('failed'),None]):
+   with self.assertRaises(OSError):s.close()
+   self.assertEqual(s.status()['state'],'cleanup_pending')
+   with self.assertRaises(m.Refused):s.current_target()
+   with self.assertRaises(m.Refused):s.switch('1'*32)
+   s.close()
+  self.assertTrue(p.stdout.closed);self.assertEqual(s.status()['state'],'closed')
+ def test_malformed_specs_fail_closed(self):
+  for token,spec in [('x',S),('1'*32,{**S,'binary':'relative'}),('2'*32,{**S,'scene_sha':'0'}),('3'*32,{**S,'runtime':'../bad'})]:
+   with self.assertRaises(m.Refused):m.SceneSwitcher({token:spec})
+if __name__=='__main__':unittest.main(verbosity=2)
