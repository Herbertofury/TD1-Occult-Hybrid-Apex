+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Launch one explicitly pinned private CAS diagnostic on loopback.
+
+Only execute an independently reviewed locally built preview server. Trusted
+local paths are required; pin checks are not a hostile-filesystem sandbox.
+The runtime is a partial preview, not a native game, installer or Tray save.
+"""
+import argparse,hashlib,json,os,pathlib,re,sys
+ROOT=pathlib.Path(__file__).resolve().parents[1];PRIVATE=ROOT/'private-input-recovery';D=re.compile(r'[a-f0-9]{64}\Z');N=re.compile(r'[a-z0-9][a-z0-9-]{0,31}\Z')
+ASSETS={'pose-config.bin','AH00B-SugarHair-V1-Plain.rgba','eyes.2048.rgba','tone-base.2048.rgba','miiko-rhea-skin.2048.rgba','myshunosun-caroline-tattoo.2048.rgba','Jius-BowFlipFlops01.2048.rgba','FatalRose-PastelGothDress.2048.rgba'};MESHES={'head.apxmesh','dress.apxmesh','shoes.apxmesh','hair.apxmesh'}
+def pin(path,digest,limit):
+ if not D.fullmatch(digest) or path.is_symlink() or not path.is_file() or path.stat().st_size>limit:raise ValueError('bounded pinned regular file required')
+ h=hashlib.sha256()
+ with path.open('rb') as f:
+  for b in iter(lambda:f.read(1024*1024),b''):h.update(b)
+ if h.hexdigest()!=digest:raise ValueError('runtime identity mismatch')
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--runtime',required=True);p.add_argument('--runtime-sha',required=True);p.add_argument('--binary',required=True);p.add_argument('--binary-sha',required=True);a=p.parse_args()
