+ if PRIVATE.is_symlink() or not PRIVATE.is_dir():raise ValueError('private parent unavailable')
+ root=PRIVATE/a.runtime
+ if root.is_symlink() or not root.is_dir():raise ValueError('runtime unavailable')
+ for child in ('assets','poses'):
+  pth=root/child
+  if pth.is_symlink() or not pth.is_dir():raise ValueError('runtime directory refused')
