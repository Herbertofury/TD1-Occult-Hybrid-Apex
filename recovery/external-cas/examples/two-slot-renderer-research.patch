+//! Private bounded real-corpus renderer comparison; no game writes.
+pub mod cc_scene;use sha2::{Digest,Sha256};use std::time::Instant;
+fn main()->Result<(),Box<dyn std::error::Error>>{let a:Vec<_>=std::env::args().collect();if a.len()!=6{return Err("scene-dir head dress shoes hair".into())}let ids=std::env::var("CC_REAL_POSE_IDS")?;let ids:Vec<_>=ids.split(',').collect();if ids.len()!=23{return Err("expected 23 prepared IDs".into())}let scene=cc_scene::CcScene::load(&a[1..6])?;let sw=[cc_scene::swatch_catalog::DEFAULT_ID,cc_scene::swatch_catalog::SWATCHES[1].id,cc_scene::swatch_catalog::SWATCHES[2].id];for (i,id) in ids.iter().enumerate(){for (j,s) in sw.iter().enumerate(){let at=Instant::now();let f=scene.render_clip_swatch(s,id,0,0,[0,0,0,16384])?;let ms=at.elapsed().as_secs_f64()*1000.;println!("{{\"pose\":{i},\"swatch\":{j},\"ms\":{ms:.3},\"rgb\":\"{:x}\",\"covered\":{}}}",Sha256::digest(&f.rgb),f.covered_pixels)}}Ok(())}
