+//! Private same-scene bounded renderer comparison; no game writes.
+pub mod cc_scene;
+use sha2::{Digest,Sha256};use std::time::Instant;
+fn main()->Result<(),Box<dyn std::error::Error>>{let a:Vec<_>=std::env::args().collect();if a.len()!=7{return Err("scene-dir head dress shoes hair pose-id".into())}let scene=cc_scene::CcScene::load(&a[1..6])?;let mut first=None;for i in 0..4{let at=Instant::now();let f=scene.render_clip_swatch(cc_scene::swatch_catalog::DEFAULT_ID,&a[6],0,0,[0,0,0,16384])?;let ms=at.elapsed().as_secs_f64()*1000.;let hash=format!("{:x}",Sha256::digest(&f.rgb));if let Some(ref prev)=first{if prev!=&hash{return Err("renderer output changed across repeats".into())}}else{first=Some(hash.clone())}println!("{{\"iteration\":{i},\"render_ms\":{ms:.3},\"rgb_sha256\":\"{hash}\",\"covered_pixels\":{}}}",f.covered_pixels);}Ok(())}
