+// Tab-local recovery of preview controls only; never game data or shared outfits.
+const LIMIT=65536, owners=new WeakMap();
+function key(scene){if(typeof scene!=='string'||!/^[a-f0-9]{64}$/.test(scene))throw Error('Verified scene identity required');return 'apex.cc-preview.v1.'+scene;}
+export function loadCcHistory(history,storage,scene){
+ const name=key(scene),raw=storage.getItem(name);
+ if(raw!==null){if(typeof raw!=='string'||raw.length>LIMIT)throw Error('Retained preview history exceeds limit');history.restoreState(JSON.parse(raw));}
+ owners.set(history,{storage,name,raw});return raw!==null;
+}
+export function saveCcHistory(history,storage,scene){
+ const name=key(scene),prior=owners.get(history),current=storage.getItem(name);
+ if(!prior||prior.storage!==storage||prior.name!==name||prior.raw!==current)throw Error('Retained preview history changed; refusing overwrite');
+ const raw=JSON.stringify(history.exportState());if(raw.length>LIMIT)throw Error('Preview history exceeds limit');
+ storage.setItem(name,raw);if(storage.getItem(name)!==raw)throw Error('Preview history readback changed');owners.set(history,{storage,name,raw});
+}
