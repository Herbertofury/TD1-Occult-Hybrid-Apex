+import copy, unittest
+from build_combinatorial_bindings import clothing_sources
+
+class TestDescriptors(unittest.TestCase):
+ def setUp(self):
+  self.top='034AEECB:80000000:0123456789ABCDEF';self.bottom='034AEECB:80000000:FEDCBA9876543210';self.dress=['APX-GENERIC-DRESS-1',self.top,'5','ff112233','a'*64,'b'*64,'c'*64];self.marker={'asset_hashes':{'FatalRose-PastelGothDress.2048.rgba':'a'*64},'mesh_hashes':{'dress.apxmesh':'b'*64}}
+ def test_dress_and_pair(self):
+  self.assertEqual(set(clothing_sources(self.dress,self.marker,self.top)),{'dress'})
+  pair=['APX-GENERIC-PAIR-1',*self.dress[1:],self.bottom,'d'*64];v=clothing_sources(pair,self.marker,self.top);self.assertEqual(v['top'],('c'*64,self.top,6));self.assertEqual(v['bottom'],('d'*64,self.bottom,7))
+ def test_refuses_wrong_identity_and_malformed_fields(self):
+  for pos,value in [(1,'bad'),(2,'65536'),(3,'gg000000'),(4,'f'*64),(5,'e'*64),(6,'BAD')]:
+   bad=list(self.dress);bad[pos]=value
+   with self.subTest(pos=pos),self.assertRaises(ValueError):clothing_sources(bad,self.marker,self.top)
+  with self.assertRaises(ValueError):clothing_sources(self.dress,self.marker,self.bottom)
+  pair=['APX-GENERIC-PAIR-1',*self.dress[1:],'bad','d'*64]
