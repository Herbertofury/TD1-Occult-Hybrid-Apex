+use apex_external_cas_draft_research::{mesh::SceneBudget,preview::{self,Camera,FramingBounds,MaterialSplit,texture::OpaqueTexture},skin::pose_rigid};
+use sha2::{Digest,Sha256};
+use std::{env,fs,io::Read,path::Path};
+fn load(path:&str,expected:&str,limit:u64)->Result<Vec<u8>,Box<dyn std::error::Error>>{
+ if expected.len()!=64 || !expected.bytes().all(|c|c.is_ascii_digit()||(b'a'..=b'f').contains(&c)){return Err("invalid digest".into())}
+ let p=Path::new(path);let m=fs::symlink_metadata(p)?;if !m.file_type().is_file() || m.len()>limit{return Err("bounded regular input required".into())}
+ let mut raw=Vec::new();fs::File::open(p)?.take(limit+1).read_to_end(&mut raw)?;
+ if raw.len() as u64>limit || format!("{:x}",Sha256::digest(&raw))!=expected{return Err("input pin mismatch".into())}Ok(raw)
+}
+fn main()->Result<(),Box<dyn std::error::Error>>{
+ let args:Vec<_>=env::args().skip(1).collect();
+ // Six pairs: head, top, bottom, shoes, hair, combined; then 1..128 pose pairs.
