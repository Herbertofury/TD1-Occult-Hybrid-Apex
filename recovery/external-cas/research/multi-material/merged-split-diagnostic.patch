+ let mut b=SceneBudget::default();let top=b.validate(&meshes[1],165)?;let bottom=b.validate(&meshes[2],165)?;let mut b=SceneBudget::default();let merged=b.validate(&meshes[5],165)?;
+ if merged.vertex_count!=top.vertex_count+bottom.vertex_count || merged.index_count!=top.index_count+bottom.index_count || !merged.vertices.starts_with(top.vertices) || &merged.vertices[top.vertices.len()..]!=bottom.vertices || !merged.indices.starts_with(top.indices){return Err("merged component mismatch".into())}
+ for (actual,original) in merged.indices[top.indices.len()..].chunks_exact(4).zip(bottom.indices.chunks_exact(4)) {let a=u32::from_le_bytes(actual.try_into()?);let b=u32::from_le_bytes(original.try_into()?);if b.checked_add(top.vertex_count)!=Some(a){return Err("merged index mismatch".into())}}
