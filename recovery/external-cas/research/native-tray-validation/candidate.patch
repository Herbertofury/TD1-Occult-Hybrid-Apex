+        self.template = household([self.target])
+        self.records = [record(self.source, 42)]
+        self.mapping = {'42': '101'}
+
+    def run_completion(self, **kwargs):
+        args = dict(template=self.template, records=self.records, mapping=self.mapping, catalog=self.catalog)
+        args.update(kwargs)
