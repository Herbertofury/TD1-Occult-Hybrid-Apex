+            wire.validate_fields(raw, wire.schema_fields(catalog, 'A'), catalog)
+        catalog = dict(field_schemas={'A': [descriptor('values', 1, 'uint64', repeated=True)]})
+        with patch.object(wire, 'MAX_FIELDS', 10), self.assertRaisesRegex(ValueError, 'field count'):
+            wire.validate_fields(field(1, b'\0' * 11), wire.schema_fields(catalog, 'A'), catalog)
