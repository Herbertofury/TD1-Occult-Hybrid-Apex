+"""Bounded native protobuf edits with exact retention of untouched wire bytes.
+
+Pure Python: no game imports, process contact, generated game classes or file IO.
+This validates structure, not whether The Sims 4 will accept a household.
+"""
+
+MAX_BYTES = 16 * 1024 * 1024
+MAX_FIELDS = 100000
+MAX_DEPTH = 32
+WIRE_TYPES = {
+    'double': 1, 'float': 5, 'int64': 0, 'uint64': 0, 'int32': 0,
+    'fixed64': 1, 'fixed32': 5, 'bool': 0, 'string': 2, 'message': 2,
+    'bytes': 2, 'uint32': 0, 'enum': 0, 'sfixed32': 5, 'sfixed64': 1,
+    'sint32': 0, 'sint64': 0,
+}
+
+
+def varint(value):
+    if type(value) is not int or not 0 <= value < 1 << 64:
+        raise ValueError('Native unsigned protobuf integer required.')
+    out = bytearray()
+    while value > 127:
+        out.append((value & 127) | 128)
+        value >>= 7
+    out.append(value)
+    return bytes(out)
+
+
+def _varint(raw, offset):
+    value = 0
+    for shift in range(0, 70, 7):
+        if offset >= len(raw):
+            raise ValueError('Truncated native protobuf varint.')
+        byte = raw[offset]
+        offset += 1
+        value |= (byte & 127) << shift
+        if not byte & 128:
+            if value >= 1 << 64:
+                raise ValueError('Native protobuf varint overflow.')
+            return value, offset
+    raise ValueError('Overlong native protobuf varint.')
+
+
+def chunks(raw):
+    if not isinstance(raw, bytes) or len(raw) > MAX_BYTES:
+        raise ValueError('Bounded native protobuf bytes required.')
+    offset = count = 0
+    while offset < len(raw):
+        count += 1
+        if count > MAX_FIELDS:
+            raise ValueError('Native protobuf field count exceeds its bound.')
+        start = offset
+        tag, offset = _varint(raw, offset)
+        number, kind = tag >> 3, tag & 7
+        if not 0 < number < 1 << 29:
+            raise ValueError('Invalid native protobuf field number.')
+        if kind == 0:
+            value, offset = _varint(raw, offset)
+        else:
+            if kind == 2:
+                size, offset = _varint(raw, offset)
+            elif kind in (1, 5):
+                size = 8 if kind == 1 else 4
+            else:
+                raise ValueError('Unsupported native protobuf wire type.')
+            if size > len(raw) - offset:
+                raise ValueError('Truncated native protobuf field.')
+            value = raw[offset:offset + size]
+            offset += size
+        yield number, kind, value, raw[start:offset]
+
+
+def blob(number, value):
+    if type(number) is not int or not 0 < number < 1 << 29 or not isinstance(value, bytes):
+        raise ValueError('Native protobuf field number/bytes required.')
+    return varint(number * 8 + 2) + varint(len(value)) + value
+
+
+def replace(raw, changes):
+    for number, entries in changes.items():
+        for wire in entries:
+            parsed = list(chunks(wire))
+            if len(parsed) != 1 or parsed[0][0] != number:
+                raise ValueError('Native replacement must match its exact field owner.')
+    out, done = [], set()
+    for number, _kind, _value, wire in chunks(raw):
+        if number not in changes:
+            out.append(wire)
+        elif number not in done:
+            out.extend(changes[number])
+            done.add(number)
+    for number in sorted(set(changes) - done):
+        out.extend(changes[number])
+    return b''.join(out)
+
+
+def schema_fields(catalog, message):
+    schemas = catalog.get('field_schemas') if isinstance(catalog, dict) else None
+    if not isinstance(schemas, dict) or not 1 <= len(schemas) <= 2048:
+        raise ValueError('Bounded native descriptor catalog required.')
+    rows = schemas.get(message)
+    if not isinstance(rows, list) or len(rows) > 4096:
+        raise ValueError('Bounded native descriptor field list required.')
+    names, numbers, result = set(), set(), {}
+    for row in rows:
+        if not isinstance(row, dict):
+            raise ValueError('Typed native descriptor field required.')
+        name, number, kind = row.get('name'), row.get('number'), row.get('type')
+        if (not isinstance(name, str) or not name or len(name) > 256 or
+                type(number) is not int or not 0 < number < 1 << 29 or
+                name in names or number in numbers or not isinstance(kind, str) or kind not in WIRE_TYPES or
+                type(row.get('repeated')) is not bool):
+            raise ValueError('Native schema fields are invalid, duplicate or unsupported.')
+        if kind == 'message' and (not isinstance(row.get('message_type'), str) or
+                                  row['message_type'] not in schemas):
+            raise ValueError('Native nested descriptor is missing.')
+        names.add(name)
+        numbers.add(number)
+        result[name] = row
+    return result
+
+
+def validate_fields(raw, selected, catalog, depth=0, budget=None):
+    """Validate selected owners and their declared descendants; preserve unknowns.
+
+    Repeated numeric protobuf fields permit packed, unpacked and mixed encoding.
+    A missing optional field is legitimate and remains absent. Singular fields
+    must never be silently merged or collapsed. Unknown valid wire is opaque.
+    """
+    if depth > MAX_DEPTH:
+        raise ValueError('Native descriptor nesting exceeds its bound.')
+    if budget is None:
+        budget = [0]
+    by_number = {row['number']: row for row in selected.values()}
+    seen = set()
+    for number, kind, value, _wire in chunks(raw):
+        budget[0] += 1
+        if budget[0] > MAX_FIELDS:
+            raise ValueError('Native descriptor field count exceeds its bound.')
+        row = by_number.get(number)
+        if row is None:
+            continue
+        if number in seen and not row['repeated']:
+            raise ValueError('Native singular field is ambiguous: ' + row['name'])
+        seen.add(number)
+        expected = WIRE_TYPES[row['type']]
+        packed = row['repeated'] and expected != 2 and kind == 2
+        if kind != expected and not packed:
+            raise ValueError('Native field wire type differs: ' + row['name'])
+        if packed:
+            if expected in (1, 5):
+                width = 8 if expected == 1 else 4
+                if len(value) % width:
+                    raise ValueError('Truncated packed native fixed-width field.')
+                budget[0] += len(value) // width
+            else:
+                offset = 0
+                while offset < len(value):
+                    _item, offset = _varint(value, offset)
+                    budget[0] += 1
+                    if budget[0] > MAX_FIELDS:
+                        raise ValueError('Native descriptor field count exceeds its bound.')
+            if budget[0] > MAX_FIELDS:
+                raise ValueError('Native descriptor field count exceeds its bound.')
+        elif row['type'] == 'message':
+            validate_fields(value, schema_fields(catalog, row['message_type']), catalog, depth + 1, budget)
+        elif row['type'] == 'string':
+            value.decode('utf-8')
