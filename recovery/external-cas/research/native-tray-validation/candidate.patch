+
+    def test_recursion_and_aggregate_field_limits(self):
+        catalog = dict(field_schemas={'A': [descriptor('child', 1, 'message', message='A')]})
+        raw = b''
+        for _ in range(wire.MAX_DEPTH + 2):
+            raw = field(1, raw)
