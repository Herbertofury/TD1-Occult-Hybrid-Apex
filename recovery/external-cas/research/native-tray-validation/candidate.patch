+"""Optional independent oracle. Requires protobuf from the official registry.
+
+Fixture-only descriptors; this is not installed-game schema evidence.
+Run with /tmp/tray-protobuf-oracle and this tests directory on PYTHONPATH.
+"""
+import json
+import random
+import struct
+
+import google.protobuf
+from google.protobuf import descriptor_pb2, descriptor_pool, message_factory
+from test_native_completion import catalog_fixture, descriptor, field, household, record, sim_fixture
+import tray_complete_appearance as completion
+import tray_library
+import tray_native_wire as wire
+import base64
+
+
+def model(catalog):
+    file = descriptor_pb2.FileDescriptorProto(name='generated_tray_fixture.proto', package='fixture', syntax='proto2')
+    for name, rows in catalog['field_schemas'].items():
+        message = file.message_type.add(name=name)
+        for row in rows:
+            item = message.field.add(name=row['name'], number=row['number'])
+            item.type = descriptor_pb2.FieldDescriptorProto.Type.Value('TYPE_' + row['type'].upper())
+            item.label = item.LABEL_REPEATED if row['repeated'] else item.LABEL_OPTIONAL
+            if row['type'] == 'message':
+                item.type_name = '.fixture.' + row['message_type']
+    pool = descriptor_pool.DescriptorPool()
+    pool.Add(file)
+    return message_factory.GetMessageClass(pool.FindMessageTypeByName('fixture.Sim'))
+
+
+def main():
+    catalog = catalog_fixture()
+    Sim = model(catalog)
+    root = wire.schema_fields(catalog, 'Sim')
+    proofs = []
+    for seed in range(64):
+        randomizer = random.Random(seed)
+        source = sim_fixture(42, 7)
+        target = sim_fixture(101, 3)
+        # Vary exact integer lengths, categories, order and packed/unpacked flags.
+        outfits = b''
+        count = 1 + seed % 5
+        for index in range(count):
+            flags = [randomizer.getrandbits(64) for _ in range(1 + seed % 9)]
+            mixed = field(14, b''.join(wire.varint(v) for v in flags[:-1])) + field(14, flags[-1], 0)
+            outfit = (field(1, randomizer.getrandbits(64), 0) + field(2, index % 3, 0) +
+                      field(5, field(1, randomizer.getrandbits(64), 0)) + mixed +
+                      field(211, bytes(randomizer.randrange(256) for _ in range(seed % 23))))
+            outfits += field(1, outfit)
+        source = wire.replace(source, {root['outfits']['number']: [field(root['outfits']['number'], outfits)]})
+        if seed % 2:
+            source = wire.replace(source, {root['custom_texture']['number']: []})
+        before = Sim.FromString(target)
+        canonical = Sim.FromString(source)
+        output, proof = completion.complete(household([target]), [record(source, 42)], {'42': '101'}, catalog)
+        native = base64.b64decode(tray_library.sims(output)['sims'][0])
+        actual = Sim.FromString(native)
+        assert actual.sim_id == before.sim_id == 101
+        for name in completion.ACTIVE:
+            assert actual.HasField(name) == canonical.HasField(name), (seed, name)
+            assert getattr(actual, name) == getattr(canonical, name), (seed, name)
+        assert actual.attributes.occult_tracker == canonical.attributes.occult_tracker
+        assert actual.attributes.trait_tracker == canonical.attributes.trait_tracker
+        assert actual.attributes.relationships == before.attributes.relationships
+        # The official protobuf parser must be able to deserialize its own
+        # reserialization too; native candidate bytes are not replaced by it.
+        assert Sim.FromString(actual.SerializeToString()) == actual
+        assert proof['native_library_load_verified'] is False
+        proofs.append({'seed': seed, 'outfits': count, 'native_bytes': len(native)})
+    print(json.dumps({'ok': True, 'protobuf_version': google.protobuf.__version__, 'cases': proofs,
+                      'scope': 'Generated schemas and fixtures only; no installed-game validation'}, indent=2))
+
+
+if __name__ == '__main__':
+    main()
