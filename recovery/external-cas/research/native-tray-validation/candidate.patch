+"""Generated descriptor/wire fixtures, never game-validity evidence."""
+import base64
+import copy
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+import zipfile
+
+TOOLS = Path(__file__).resolve().parents[1] / 'tools'
+sys.path.insert(0, str(TOOLS))
+import tray_complete_appearance as completion
+import tray_library
+import tray_native_wire as wire
+
+
+def field(number, value, kind=2):
+    prefix = wire.varint(number * 8 + kind)
+    if kind == 2:
+        return prefix + wire.varint(len(value)) + value
+    if kind == 0:
+        return prefix + wire.varint(value)
+    return prefix + value
+
+
+def descriptor(name, number, kind, repeated=False, message=None):
+    result = dict(name=name, number=number, type=kind, repeated=repeated)
+    if message is not None:
+        result['message_type'] = message
+    return result
+
+
+def catalog_fixture():
+    kinds = ['uint32', 'string', 'bytes', 'fixed64', 'float', 'message',
+             'message', 'fixed64', 'message', 'float', 'uint32', 'uint32', 'message']
+    root = [descriptor('sim_id', 1, 'fixed64'), descriptor('first_name', 2, 'string'),
+            descriptor('last_name', 3, 'string'), descriptor('age', 4, 'uint32'),
+            descriptor('gender', 5, 'uint32'), descriptor('attributes', 6, 'message', message='Attributes')]
+    for index, (name, kind) in enumerate(zip(completion.ACTIVE, kinds), 10):
+        root.append(descriptor(name, index, kind, message='OutfitList' if name == 'outfits' else 'Opaque' if kind == 'message' else None))
+    return dict(native_message_type='Sim', field_schemas={
+        'Sim': root,
+        'Attributes': [descriptor('occult_tracker', 1, 'message', message='Tracker'),
+                       descriptor('trait_tracker', 2, 'message', message='Tracker'),
+                       descriptor('relationships', 3, 'bytes')],
+        'Tracker': [descriptor('values', 1, 'uint64', repeated=True)],
+        'OutfitList': [descriptor('outfits', 1, 'message', repeated=True, message='Outfit')],
+        'Outfit': [descriptor('outfit_id', 1, 'uint64'), descriptor('category', 2, 'uint32'),
+                   descriptor('parts', 5, 'message', message='Opaque'),
+                   descriptor('flags', 14, 'uint64', repeated=True)],
+        'Opaque': [],
+    })
+
+
+def sim_fixture(sid, variant, first='Person'):
+    schema = catalog_fixture()
+    attrs = (field(1, field(1, variant, 0) + field(200, b'unknown occult')) +
+             field(2, field(1, variant + 1, 0)) + field(3, b'relationship-' + bytes([variant])) +
+             field(202, b'future attribute-' + bytes([variant])))
+    out = (field(1, struct.pack('<Q', sid), 1) + field(2, first.encode()) + field(3, b'Native') +
+           field(4, 8, 0) + field(5, 1, 0) + field(6, attrs))
+    for row in schema['field_schemas']['Sim'][6:]:
+        kind = wire.WIRE_TYPES[row['type']]
+        if row['name'] == 'outfits':
+            # Fixture-only flags number. Real fields always come from catalog.
+            outfit = (field(1, 1000 + variant, 0) + field(2, 0, 0) +
+                      field(5, field(1, 1234 + variant, 0)) +
+                      field(14, wire.varint(variant) + wire.varint(variant + 1)) +
+                      field(14, variant + 2, 0) + field(211, b'unknown outfit'))
+            value = field(1, outfit) + field(220, b'unknown outfit-list')
+        elif row['type'] == 'message':
+            value = field(200, bytes([variant]))
+        elif kind == 2:
+            value = ('body-' + str(variant)).encode()
+        elif kind == 0:
+            value = variant
+        else:
+            value = bytes([variant]) * (8 if kind == 1 else 4)
+        out += field(row['number'], value, kind)
+    return out + field(230, b'unknown root-' + bytes([variant]))
+
+
+def household(sims, footer=b'\x91\x00\x00\x00\x00'):
+    body = field(3, b'Native household') + field(2, 2026, 0)
+    body += b''.join(field(6, sim) for sim in sims) + field(201, b'unknown household')
+    payload = field(1, body) + field(231, b'unknown outer')
+    return struct.pack('<IIII', 2, 12 + len(payload) + len(footer), 0, len(payload)) + payload + footer
+
+
+def record(raw, sid):
+    return dict(sim_id=str(sid), native_sim=base64.b64encode(raw).decode(),
+                native_sha256=hashlib.sha256(raw).hexdigest())
+
+
+def without(raw, numbers):
+    return [(n, k, b) for n, k, _v, b in wire.chunks(raw) if n not in numbers]
+
+
