+        self.assertEqual(without(actual, owners), without(self.target, owners))
+        active = {root[name]['number'] for name in completion.ACTIVE}
+        self.assertEqual(without(actual, set(root[x]['number'] for x in root) - active | {230}),
+                         without(self.source, set(root[x]['number'] for x in root) - active | {230}))
+        actual_attrs = completion.one(actual, root['attributes'], 2)
+        original_attrs = completion.one(self.target, root['attributes'], 2)
