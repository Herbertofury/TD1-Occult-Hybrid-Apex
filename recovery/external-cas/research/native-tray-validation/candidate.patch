+            catalog = dict(field_schemas={'A': [descriptor('values', 1, kind, repeated=True)]})
+            fields = wire.schema_fields(catalog, 'A')
+            wire.validate_fields(field(1, good), fields, catalog)
+            with self.subTest(kind=kind), self.assertRaises(ValueError):
