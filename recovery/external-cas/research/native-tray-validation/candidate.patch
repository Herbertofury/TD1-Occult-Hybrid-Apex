+        raw = b'\x88\x00\x81\x00' + field(222, b'opaque') + field(1, 3, 0)
+        self.assertEqual(b''.join(row[3] for row in wire.chunks(raw)), raw)
+        self.assertEqual(wire.replace(raw, {}), raw)
